{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "venus-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "venus-workers",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "-c",
        "wrangler.jsonc",
        "-c",
        "../venus-admin-panel/wrangler.jsonc",
        "--port",
        "8788"
      ],
      "port": 8788
    }
  ]
}
