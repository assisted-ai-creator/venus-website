# Copy to .env.local for development. In production these are set as `vars` in
# wrangler.jsonc, except CMS_SITE_KEY which should be a secret.

# The content API — the venus-admin-panel worker.
CMS_API_URL=http://127.0.0.1:8787

# Must match SITE_API_KEY on that worker.
CMS_SITE_KEY=dev-site-key

# Only used by `npm run cms:seed`. Must match BOOTSTRAP_TOKEN on that worker.
CMS_BOOTSTRAP_TOKEN=dev-bootstrap-token

# How long a snapshot may be reused inside one worker isolate, in milliseconds.
# 0 means every render reads the live content — which is what makes an edit in
# the panel appear on the next request. Raise it only if traffic makes the
# reads worth collapsing; edits then take up to this long to show.
CMS_CACHE_MS=0
